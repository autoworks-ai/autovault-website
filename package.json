{
  "name": "autovault-website",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "ci": "npm run typecheck && npm test && npm run pages:functions:build && npm run docs:build",
    "dev": "npm run docs:dev",
    "docs:dev": "vitepress dev --host 0.0.0.0",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview --host 0.0.0.0",
    "dev:bootstrap": "wrangler d1 migrations apply autovault-hosted --local",
    "dev:pages": "npm run docs:build && wrangler pages dev .vitepress/dist --port 8788 --persist-to .wrangler/state",
    "dev:pages:live": "wrangler pages dev --proxy 5173 --port 8788 --persist-to .wrangler/state -- npm run docs:dev",
    "dev:stripe": "stripe listen --forward-to http://localhost:8788/api/billing/webhook",
    "deploy:pages": "npm run docs:build && wrangler pages deploy .vitepress/dist --project-name autovault-website",
    "pages:functions:build": "wrangler pages functions build functions --outdir .wrangler/tmp/pages-functions",
    "pages:preview-config": "node scripts/write-pages-preview-config.mjs",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.7",
    "vue": "^3.5.35",
    "vue-tsc": "^3.3.2",
    "wrangler": "^4.95.0"
  },
  "dependencies": {
    "@clerk/backend": "^3.4.12",
    "@clerk/vue": "^2.3.0",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "@clerk/shared": {
      "js-cookie": "3.0.7"
    }
  }
}
